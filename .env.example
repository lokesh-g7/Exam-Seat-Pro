# ExamSeat Pro - Environment Configuration Template
# Copy this file to .env and replace with production values. Never commit .env to version control!

# Backend Port
SERVER_PORT=8080

# JWT Security
# Must be at least 256 bits (32+ characters) long
JWT_SECRET=YourSuperSecretKeyForJWTGeneration256BitsMinimumLengthRequired!
JWT_EXPIRATION=86400000

# Database Credentials
DB_URL=jdbc:h2:file:./examseat.db
DB_USERNAME=sa
DB_PASSWORD=

# Initial Administrator Credentials (used for first initialization)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=ChangeThisPasswordInProduction!

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

